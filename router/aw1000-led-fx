#!/bin/sh
# ==============================================================================
# AW1000 Front-Panel LED FX Controller (15 Modes + Stock + Off)
# Modes: stock | off | knight | comet | ripple | strobe | matrix | stack |
#        heartbeat | heartbeat3 | wingtip | smart5g | traffic | signal |
#        guardian | mix | random | dance
# Safe: only touches /sys/class/leds/* and /etc/init.d/led_ctrld.init.
# Never touches SSH, NetBird, Tailscale, firewall, or modem.
# ==============================================================================

PID_FILE="/tmp/aw1000-led-fx.pid"
MODE_FILE="/tmp/aw1000-led-fx.mode"
LAST_ON_FILE="/tmp/aw1000-led-fx.last"

ALL_LEDS="status:green status:red internet:single 5g:signal signal:green signal:red wifi:green wifi:red phone:green phone:red"

stop_fx_loop() {
	if [ -f "$PID_FILE" ]; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill "$pid" 2>/dev/null || true
		fi
		rm -f "$PID_FILE"
	fi
}

clear_all_leds() {
	for l in $ALL_LEDS; do
		[ -w "/sys/class/leds/$l/trigger" ] && echo "none" > "/sys/class/leds/$l/trigger" 2>/dev/null || true
		[ -w "/sys/class/leds/$l/brightness" ] && echo "0" > "/sys/class/leds/$l/brightness" 2>/dev/null || true
	done
}

stop_stock_daemon() {
	uci -q set led_ctrld.default_setting=setting || true
	uci -q set led_ctrld.default_setting.lights_enabled=0 || true
	uci -q commit led_ctrld || true
	LED_TOGGLE_RESTART=1 /etc/init.d/led_ctrld.init restart >/dev/null 2>&1 || true
}

start_stock_daemon() {
	uci -q set led_ctrld.default_setting=setting || true
	uci -q set led_ctrld.default_setting.lights_enabled=1 || true
	uci -q commit led_ctrld || true
	LED_TOGGLE_RESTART=1 /etc/init.d/led_ctrld.init restart >/dev/null 2>&1 || true
}

run_lua_fx() {
	fx_mode="$1"
	LUA_SCRIPT="/tmp/aw1000-led-fx.lua"
	cat <<'LUA' > "$LUA_SCRIPT"
local mode = arg[1] or "knight"
local ok_nixio, nixio = pcall(require, "nixio")
local ok_json, json = pcall(require, "luci.jsonc")
math.randomseed(math.floor(os.time()))

local function msleep(ms)
	if ok_nixio and nixio.nanosleep then
		nixio.nanosleep(math.floor(ms / 1000), (ms % 1000) * 1000000)
	else
		os.execute("sleep 1")
	end
end

local function set_led(name, val)
	local f = io.open("/sys/class/leds/" .. name .. "/brightness", "w")
	if f then
		f:write(val and "255" or "0")
		f:close()
	end
end

-- 6 front-panel slots top-to-bottom (g = green/primary, r = red)
local slots = {
	{ g = "status:green",    r = "status:red" },
	{ g = "internet:single", r = nil },
	{ g = "5g:signal",       r = nil },
	{ g = "signal:green",    r = "signal:red" },
	{ g = "wifi:green",      r = "wifi:red" },
	{ g = "phone:green",     r = "phone:red" },
}

local function set_slot(idx, color)
	local s = slots[idx]
	if not s then return end
	if color == "off" then
		set_led(s.g, false)
		if s.r then set_led(s.r, false) end
	elseif color == "green" then
		set_led(s.g, true)
		if s.r then set_led(s.r, false) end
	elseif color == "red" then
		if s.r then
			set_led(s.g, false)
			set_led(s.r, true)
		else
			set_led(s.g, true)
		end
	elseif color == "amber" then
		set_led(s.g, true)
		if s.r then set_led(s.r, true) end
	end
end

local function all_off()
	for i = 1, #slots do set_slot(i, "off") end
end

local function read_bytes(iface)
	local rx, tx = 0, 0
	local f1 = io.open("/sys/class/net/" .. iface .. "/statistics/rx_bytes", "r")
	if f1 then rx = tonumber(f1:read("*a")) or 0; f1:close() end
	local f2 = io.open("/sys/class/net/" .. iface .. "/statistics/tx_bytes", "r")
	if f2 then tx = tonumber(f2:read("*a")) or 0; f2:close() end
	return rx + tx
end

local function find_wan_iface()
	-- Prefer whichever ccmni interface carries the default route
	local p = io.popen("ip route show default 2>/dev/null")
	if p then
		local line = p:read("*l") or ""
		p:close()
		local dev = line:match("dev%s+(%S+)")
		if dev and dev ~= "" then return dev end
	end
	for _, ifc in ipairs({ "ccmni1", "ccmni2", "ccmni0", "eth0" }) do
		local f = io.open("/sys/class/net/" .. ifc .. "/statistics/rx_bytes", "r")
		if f then f:close(); return ifc end
	end
	return "ccmni1"
end

local function read_telemetry()
	if not ok_json then return nil end
	local p = io.popen("/usr/bin/aw1000-telemetry --full 2>/dev/null")
	if not p then return nil end
	local raw = p:read("*a") or ""
	p:close()
	return json.parse(raw)
end

-- Each animation runs one full cycle (~2-4 seconds) so mix & random can compose cleanly
local fx = {}

function fx.knight(cycles)
	local colors = { "green", "amber", "red" }
	local seq = { 1, 2, 3, 4, 5, 6, 5, 4, 3, 2 }
	for c = 1, (cycles or 3) do
		local col = colors[((c - 1) % #colors) + 1]
		for _, pos in ipairs(seq) do
			all_off()
			set_slot(pos, col)
			msleep(110)
		end
	end
end

function fx.comet(cycles)
	for _ = 1, (cycles or 3) do
		for head = 1, 8 do
			all_off()
			if head >= 1 and head <= 6 then set_slot(head, "red") end
			if head - 1 >= 1 and head - 1 <= 6 then set_slot(head - 1, "amber") end
			if head - 2 >= 1 and head - 2 <= 6 then set_slot(head - 2, "green") end
			msleep(115)
		end
		all_off()
		msleep(220)
	end
end

function fx.ripple(cycles)
	local colors = { "green", "amber", "red" }
	local frames = {
		{ 3, 4 },
		{ 2, 5 },
		{ 1, 6 },
		{ 2, 5 },
		{ 3, 4 }
	}
	for c = 1, (cycles or 3) do
		local col = colors[((c - 1) % #colors) + 1]
		for _, pair in ipairs(frames) do
			all_off()
			set_slot(pair[1], col)
			set_slot(pair[2], col)
			msleep(160)
		end
	end
end

function fx.strobe(cycles)
	for _ = 1, (cycles or 4) do
		for _ = 1, 2 do
			all_off()
			set_slot(1, "red"); set_slot(2, "red"); set_slot(3, "red")
			msleep(75)
			all_off()
			msleep(55)
		end
		for _ = 1, 2 do
			all_off()
			set_slot(4, "green"); set_slot(5, "green"); set_slot(6, "green")
			msleep(75)
			all_off()
			msleep(55)
		end
	end
end

function fx.matrix(steps)
	local cols = { "green", "green", "green", "amber" }
	for _ = 1, (steps or 22) do
		all_off()
		local n = math.random(2, 4)
		for _ = 1, n do
			set_slot(math.random(1, 6), cols[math.random(1, #cols)])
		end
		msleep(135)
	end
end

function fx.stack(cycles)
	for _ = 1, (cycles or 2) do
		all_off()
		for level = 1, 6 do
			local slot = 7 - level
			local col = (level <= 2) and "green" or ((level <= 4) and "amber" or "red")
			set_slot(slot, col)
			msleep(140)
		end
		msleep(350)
		for level = 6, 1, -1 do
			set_slot(7 - level, "off")
			msleep(100)
		end
		msleep(180)
	end
end

function fx.heartbeat(cycles)
	for _ = 1, (cycles or 2) do
		all_off()
		set_slot(1, "green"); msleep(130)
		all_off();            msleep(120)
		set_slot(1, "green"); msleep(130)
		all_off();            msleep(900)
	end
end

local hb3_cidx = 0
function fx.heartbeat3(cycles)
	local colors = { "green", "amber", "red" }
	for _ = 1, (cycles or 1) do
		hb3_cidx = (hb3_cidx % #colors) + 1
		local col = colors[hb3_cidx]
		for slot = 1, 6 do
			for b = 1, 3 do
				all_off()
				set_slot(slot, col)
				msleep(130)
				all_off()
				msleep(120)
			end
			msleep(240)
		end
	end
end

function fx.wingtip(cycles)
	for _ = 1, (cycles or 2) do
		-- Edge 1 (Status): double-beat Green ("lub-dub")
		all_off()
		set_slot(1, "green"); msleep(130)
		all_off();            msleep(120)
		set_slot(1, "green"); msleep(130)
		all_off();            msleep(520)
		-- Edge 6 (Phone): double-beat Red ("lub-dub")
		set_slot(6, "red");   msleep(130)
		all_off();            msleep(120)
		set_slot(6, "red");   msleep(130)
		all_off();            msleep(650)
	end
end

function fx.dance(steps)
	local palette = { "green", "amber", "red", "green", "red", "amber" }
	for step = 1, (steps or 12) do
		local pat = step % 4
		if pat == 0 then
			for i = 1, 6 do set_slot(i, (i % 2 == 0) and "green" or "red") end
		elseif pat == 1 then
			for i = 1, 6 do set_slot(i, (i % 2 == 1) and "amber" or "off") end
		elseif pat == 2 then
			for i = 1, 6 do set_slot(i, (i % 2 == 0) and "red" or "green") end
		else
			for i = 1, 6 do set_slot(i, palette[((i + step) % #palette) + 1]) end
		end
		msleep(200)
	end
end

local wan_ifc = find_wan_iface()
local prev_bytes = read_bytes(wan_ifc)

function fx.traffic(ticks)
	for _ = 1, (ticks or 10) do
		msleep(320)
		local cur = read_bytes(wan_ifc)
		local delta = cur - prev_bytes
		if delta < 0 then delta = 0 end
		prev_bytes = cur
		local kbps = (delta / 1024.0) / 0.32
		local level = 1
		if kbps >= 5000 then level = 6
		elseif kbps >= 1500 then level = 5
		elseif kbps >= 400 then level = 4
		elseif kbps >= 80 then level = 3
		elseif kbps >= 10 then level = 2
		else level = 1 end
		for i = 1, 6 do
			local slot = 7 - i
			if i <= level then
				if i <= 3 then set_slot(slot, "green")
				elseif i <= 5 then set_slot(slot, "amber")
				else set_slot(slot, "red") end
			else
				set_slot(slot, "off")
			end
		end
	end
end

function fx.signal(ticks)
	for _ = 1, (ticks or 2) do
		local tm = read_telemetry()
		local rsrp, sinr = -115, 0
		if tm and tm.cell then
			if tm.cell.nr and type(tm.cell.nr.rsrp) == "number" then
				rsrp = tm.cell.nr.rsrp
				sinr = tonumber(tm.cell.nr.sinr) or 0
			elseif tm.cell.lte and type(tm.cell.lte.rsrp) == "number" then
				rsrp = tm.cell.lte.rsrp
				sinr = tonumber(tm.cell.lte.sinr) or 0
			end
		end
		local r_norm = math.max(0, math.min(1, (rsrp + 125) / 50))
		local s_norm = math.max(0, math.min(1, (sinr + 5) / 30))
		local score = 0.6 * r_norm + 0.4 * s_norm
		local bars = math.max(1, math.min(6, math.floor(1 + score * 5 + 0.5)))
		local col = (bars <= 2) and "red" or ((bars <= 4) and "amber" or "green")
		for i = 1, 6 do
			local slot = 7 - i
			set_slot(slot, (i <= bars) and col or "off")
		end
		msleep(1500)
	end
end

function fx.guardian(ticks)
	for _ = 1, (ticks or 2) do
		local tm = read_telemetry()
		local ping = tm and tm.wan and tonumber(tm.wan.ping_ms) or nil
		local temp = tm and tm.sys and tonumber(tm.sys.t_soc) or 45
		local ip4 = tm and tm.wan and tm.wan.ip4 or ""
		if ip4 == "" or ping == nil then
			-- WAN down: urgent red flash
			for _ = 1, 3 do
				for i = 1, 6 do set_slot(i, "red") end
				msleep(220)
				all_off()
				msleep(220)
			end
		elseif ping > 80 or temp > 65 then
			-- High ping or warm SoC: amber pulse
			all_off()
			set_slot(1, "amber"); set_slot(4, "amber"); set_slot(5, "amber")
			msleep(1200)
			all_off()
			msleep(300)
		else
			-- Healthy: calm green status + signal
			all_off()
			set_slot(1, "green"); set_slot(2, "green"); set_slot(3, "green")
			msleep(1500)
		end
	end
end

local smart5g_last_ts = 0
local smart5g_has_5g = false
local smart5g_sig_col = "red"

local function refresh_smart5g_state()
	local now = os.time()
	if (now - smart5g_last_ts) < 4 and smart5g_last_ts > 0 then
		return
	end
	smart5g_last_ts = now
	local tm = read_telemetry()
	if not tm or not tm.cell then
		smart5g_has_5g = false
		smart5g_sig_col = "red"
		return
	end
	local c = tm.cell
	local rat = tostring(c.rat or ""):upper()
	local has_nr_rsrp = (c.nr and type(c.nr.rsrp) == "number")
	smart5g_has_5g = (rat:find("5G") ~= nil) or (rat:find("NR") ~= nil) or has_nr_rsrp

	local rsrp, sinr = nil, 0
	if has_nr_rsrp then
		rsrp = c.nr.rsrp
		sinr = tonumber(c.nr.sinr) or 0
	elseif c.lte and type(c.lte.rsrp) == "number" then
		rsrp = c.lte.rsrp
		sinr = tonumber(c.lte.sinr) or 0
	end

	if rsrp == nil then
		smart5g_sig_col = "red"
		return
	end

	local r_norm = math.max(0, math.min(1, (rsrp + 125) / 50))
	local s_norm = math.max(0, math.min(1, (sinr + 5) / 30))
	local pct = math.floor(10 + (0.6 * r_norm + 0.4 * s_norm) * 90 + 0.5)

	if pct >= 70 or rsrp >= -90 then
		smart5g_sig_col = "green"
	elseif pct >= 35 or rsrp >= -105 then
		smart5g_sig_col = "amber"
	else
		smart5g_sig_col = "red"
	end
end

function fx.smart5g(cycles)
	-- Only controls Slot 3 (5g:signal) & Slot 4 (signal:green + signal:red).
	-- Slots 1, 2, 5, 6 remain untouched under stock led_ctrld.
	for _ = 1, (cycles or 3) do
		refresh_smart5g_state()
		local col5g = smart5g_has_5g and "green" or "off"
		local colSig = smart5g_sig_col
		-- Beat 1 ("lub")
		set_slot(3, col5g)
		set_slot(4, colSig)
		msleep(130)
		set_slot(3, "off")
		set_slot(4, "off")
		msleep(120)
		-- Beat 2 ("dub")
		set_slot(3, col5g)
		set_slot(4, colSig)
		msleep(130)
		set_slot(3, "off")
		set_slot(4, "off")
		msleep(850)
	end
end

local mix_order = { "knight", "comet", "ripple", "matrix", "stack", "dance", "strobe", "heartbeat", "heartbeat3", "wingtip" }

if mode == "mix" then
	local idx = 1
	while true do
		local name = mix_order[idx]
		if fx[name] then fx[name]() end
		idx = (idx % #mix_order) + 1
	end
elseif mode == "random" then
	local last = ""
	while true do
		local pick = mix_order[math.random(1, #mix_order)]
		if pick == last then
			pick = mix_order[(math.random(1, #mix_order) % #mix_order) + 1]
		end
		last = pick
		if fx[pick] then fx[pick]() end
	end
elseif fx[mode] then
	while true do
		fx[mode]()
	end
else
	while true do
		fx.knight()
	end
end
LUA
	lua "$LUA_SCRIPT" "$fx_mode" </dev/null >/dev/null 2>&1 &
	echo "$!" > "$PID_FILE"
}

is_valid_mode() {
	case "$1" in
		stock|off|knight|comet|ripple|strobe|matrix|stack|heartbeat|heartbeat3|wingtip|smart5g|traffic|signal|guardian|mix|random|dance) return 0 ;;
		*) return 1 ;;
	esac
}

get_state() {
	mode="stock"
	[ -f "$MODE_FILE" ] && mode="$(cat "$MODE_FILE" 2>/dev/null)"
	is_valid_mode "$mode" || mode="stock"
	if [ "$mode" != "stock" ] && [ "$mode" != "off" ]; then
		pid="$(cat "$PID_FILE" 2>/dev/null)"
		if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
			mode="stock"
		fi
	fi
	last_on="stock"
	[ -f "$LAST_ON_FILE" ] && last_on="$(cat "$LAST_ON_FILE" 2>/dev/null)"
	is_valid_mode "$last_on" || last_on="stock"
	[ "$mode" = "off" ] && enabled="false" || enabled="true"
	printf '{"ok":true,"mode":"%s","enabled":%s,"last_mode":"%s"}\n' "$mode" "$enabled" "$last_on"
}

cmd="${1:-get}"
case "$cmd" in
	get)
		get_state
		;;
	set)
		mode="${2:-stock}"
		if ! is_valid_mode "$mode"; then
			echo '{"ok":false,"error":"Invalid LED mode"}'
			exit 0
		fi
		case "$mode" in
			stock)
				stop_fx_loop
				clear_all_leds
				start_stock_daemon
				echo "stock" > "$MODE_FILE"
				echo "stock" > "$LAST_ON_FILE"
				get_state
				;;
			off)
				stop_fx_loop
				stop_stock_daemon
				clear_all_leds
				echo "off" > "$MODE_FILE"
				get_state
				;;
			smart5g)
				stop_fx_loop
				start_stock_daemon
				for l in 5g:signal signal:green signal:red; do
					[ -w "/sys/class/leds/$l/trigger" ] && echo "none" > "/sys/class/leds/$l/trigger" 2>/dev/null || true
				done
				echo "$mode" > "$MODE_FILE"
				echo "$mode" > "$LAST_ON_FILE"
				run_lua_fx "$mode"
				get_state
				;;
			*)
				stop_fx_loop
				stop_stock_daemon
				clear_all_leds
				echo "$mode" > "$MODE_FILE"
				echo "$mode" > "$LAST_ON_FILE"
				run_lua_fx "$mode"
				get_state
				;;
		esac
		;;
	*)
		echo '{"ok":false,"error":"Usage: aw1000-led-fx get | set <mode>"}'
		exit 0
		;;
esac
