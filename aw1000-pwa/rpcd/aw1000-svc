			opkg_list)
				read -r input
				INPUT_JSON="$input" /usr/bin/lua - <<'LUA'
local json = require("luci.jsonc")
local req = json.parse(os.getenv("INPUT_JSON") or "{}") or {}
local query = tostring(req.query or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
local filter = tostring(req.filter or "installed"):lower()
if filter ~= "installed" and filter ~= "available" and filter ~= "all" then
	filter = "installed"
end

local function get_overlay()
	local p = io.popen("df -k /overlay 2>/dev/null")
	local total_kb, used_kb, avail_kb = 0, 0, 0
	if p then
		p:read("*l")
		local line = p:read("*l") or ""
		p:close()
		local t, u, a = line:match("%S+%s+(%d+)%s+(%d+)%s+(%d+)")
		total_kb = tonumber(t) or 0
		used_kb = tonumber(u) or 0
		avail_kb = tonumber(a) or 0
	end
	return {
		total_kb = total_kb,
		used_kb = used_kb,
		avail_kb = avail_kb,
		avail_mb = math.floor(avail_kb / 1024 + 0.5)
	}
end

local installed_map = {}
local installed_list = {}
local p_inst = io.popen("opkg list-installed 2>/dev/null")
if p_inst then
	for line in p_inst:lines() do
		local name, ver = line:match("^([^%s]+)%s*%-%s*(.+)$")
		if name then
			installed_map[name] = ver or ""
			table.insert(installed_list, { name = name, version = ver or "", installed = true, desc = "" })
		end
	end
	p_inst:close()
end

local lists_updated = false
local p_ls = io.popen("ls -1 /var/opkg-lists 2>/dev/null | head -n 1")
if p_ls then
	local first = p_ls:read("*l")
	p_ls:close()
	if first and first ~= "" then lists_updated = true end
end

local results = {}
local total_available = 0
local limit = 120

if filter == "installed" then
	for _, pkg in ipairs(installed_list) do
		if query == "" or pkg.name:lower():find(query, 1, true) then
			if #results < limit then
				table.insert(results, pkg)
			end
		end
	end
else
	if lists_updated then
		local p_av = io.popen("opkg list 2>/dev/null")
		if p_av then
			for line in p_av:lines() do
				local name, rest = line:match("^([A-Za-z0-9._+-]+)%s*%-%s*(.+)$")
				if name then
					local ver, desc = rest:match("^([^%s]+)%s*%-%s*(.*)$")
					if not ver then ver = rest; desc = "" end
					total_available = total_available + 1
					local is_inst = installed_map[name] ~= nil
					local match_filter = (filter == "all") or (filter == "available" and not is_inst)
					if match_filter then
						local match_q = (query == "")
							or name:lower():find(query, 1, true)
							or (desc and desc:lower():find(query, 1, true))
						if match_q and #results < limit then
							table.insert(results, {
								name = name,
								version = is_inst and installed_map[name] or ver,
								installed = is_inst,
								desc = (desc or ""):sub(1, 120)
							})
						end
					end
				end
			end
			p_av:close()
		end
	elseif filter == "all" then
		for _, pkg in ipairs(installed_list) do
			if query == "" or pkg.name:lower():find(query, 1, true) then
				if #results < limit then
					table.insert(results, pkg)
				end
			end
		end
	end
end

io.write(json.stringify({
	ok = true,
	overlay = get_overlay(),
	lists_updated = lists_updated,
	total_installed = #installed_list,
	total_available = total_available,
	filter = filter,
	query = query,
	truncated = (#results >= limit),
	packages = results
}) .. "\n")
LUA
