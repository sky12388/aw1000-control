#!/bin/sh
# ==============================================================================
# /usr/libexec/rpcd/aw1000-svc — Software & Services rpcd plugin for AW1000 PWA
#
# LIFELINE GUARD:
#   - dropbear (SSH :22) is strictly READ-ONLY / PROTECTED (cannot stop/disable/restart).
#   - Only allowlisted init.d services (netbird, tailscale, adguardhome, firewall, dnsmasq)
#     may be controlled, and only when authenticated via rpcd write ACL (Edit Mode Unlocked).
#   - opkg install/remove validates package names strictly and blocks removal of
#     critical/lifeline packages; checks /overlay free space before installing.
# ==============================================================================

case "$1" in
	list)
		cat <<'EOF'
{
  "svc_list": {},
  "svc_action": {
    "service": "netbird|tailscale|adguardhome|firewall|dnsmasq",
    "action": "start|stop|restart|enable|disable"
  },
  "opkg_list": {
    "query": "string",
    "filter": "installed|available|all"
  },
  "opkg_update": {},
  "opkg_install": {
    "package": "string"
  },
  "opkg_remove": {
    "package": "string"
  }
}
EOF
		;;

	call)
		case "$2" in
			svc_list)
				/usr/bin/lua - <<'LUA'
local json = require("luci.jsonc")

local function exec_out(cmd)
	local p = io.popen(cmd .. " 2>/dev/null")
	if not p then return "" end
	local s = p:read("*a") or ""
	p:close()
	return s
end

local function file_exists(path)
	local f = io.open(path, "r")
	if f then f:close(); return true end
	return false
end

local function is_enabled(name)
	local rc = os.execute("/etc/init.d/" .. name .. " enabled >/dev/null 2>&1")
	if rc == 0 or rc == true then return true end
	local out = exec_out("ls /etc/rc.d/S*" .. name .. " 2>/dev/null")
	return out:match("%S") ~= nil
end

local function is_running(name, bin_name)
	if name == "firewall" then
		local out = exec_out("iptables -S 2>/dev/null")
		return out:find("zone_lan_input", 1, true) ~= nil or out:find("zone_wan_input", 1, true) ~= nil
	end
	local target = (bin_name and bin_name ~= "") and bin_name or name
	local out = exec_out("pidof " .. target .. " 2>/dev/null")
	return out:match("%d+") ~= nil
end

local roster = {
	{ name = "dropbear",    label = "Dropbear SSH (:22)",        note = "Lifeline #1 — Protected read-only SSH access",      proc = "dropbear",    protected = true  },
	{ name = "netbird",     label = "NetBird VPN (wt0)",         note = "Kernel WireGuard overlay remote access",            proc = "netbird",     protected = false },
	{ name = "tailscale",   label = "Tailscale VPN",             note = "Secondary mesh VPN overlay daemon",                 proc = "tailscaled",  protected = false },
	{ name = "adguardhome", label = "AdGuard Home (:3000)",      note = "Network-wide DNS ad-blocker (127.0.0.1:5353)",      proc = "AdGuardHome", protected = false },
	{ name = "firewall",    label = "OpenWrt Firewall (fw3)",    note = "NAT, WAN/LAN zones & /etc/firewall.user rules",     proc = "",            protected = false },
	{ name = "dnsmasq",     label = "Dnsmasq DHCP & DNS",        note = "LAN DHCP server & local DNS forwarder (:53)",       proc = "dnsmasq",     protected = false }
}

local services = {}
for _, s in ipairs(roster) do
	local init_path = "/etc/init.d/" .. s.name
	local inst = file_exists(init_path)
	table.insert(services, {
		name = s.name,
		label = s.label,
		note = s.note,
		installed = inst,
		enabled = inst and is_enabled(s.name) or false,
		running = inst and is_running(s.name, s.proc) or false,
		protected = s.protected
	})
end

io.write(json.stringify({ ok = true, services = services }) .. "\n")
LUA
				;;

			svc_action)
				read -r input
				INPUT_JSON="$input" /usr/bin/lua - <<'LUA'
local json = require("luci.jsonc")
local req = json.parse(os.getenv("INPUT_JSON") or "{}") or {}
local svc = tostring(req.service or "")
local act = tostring(req.action or "")

local ALLOWED_SVC = {
	netbird = "netbird",
	tailscale = "tailscaled",
	adguardhome = "AdGuardHome",
	firewall = "",
	dnsmasq = "dnsmasq"
}
local ALLOWED_ACT = {
	start = true,
	stop = true,
	restart = true,
	enable = true,
	disable = true
}

if svc == "dropbear" then
	io.write(json.stringify({ ok = false, error = "Protected by Lifeline Guard: dropbear SSH cannot be modified" }) .. "\n")
	os.exit(0)
end

if not ALLOWED_SVC[svc] then
	io.write(json.stringify({ ok = false, error = "Service not allowed: " .. svc }) .. "\n")
	os.exit(0)
end

if not ALLOWED_ACT[act] then
	io.write(json.stringify({ ok = false, error = "Action not allowed: " .. act }) .. "\n")
	os.exit(0)
end

local init_path = "/etc/init.d/" .. svc
local f = io.open(init_path, "r")
if not f then
	io.write(json.stringify({ ok = false, error = "Init script not installed: " .. init_path }) .. "\n")
	os.exit(0)
end
f:close()

local p = io.popen(init_path .. " " .. act .. " 2>&1; echo __EXIT__$?")
local raw = p and p:read("*a") or ""
if p then p:close() end
local code = tonumber(raw:match("__EXIT__(%d+)")) or 1
local out = raw:gsub("__EXIT__%d+%s*$", "")
if act == "start" or act == "stop" or act == "restart" then
	os.execute("sleep 1")
end

local function exec_out(cmd)
	local h = io.popen(cmd .. " 2>/dev/null")
	if not h then return "" end
	local s = h:read("*a") or ""
	h:close()
	return s
end

local rc_en = os.execute(init_path .. " enabled >/dev/null 2>&1")
local enabled = (rc_en == 0 or rc_en == true) or (exec_out("ls /etc/rc.d/S*" .. svc .. " 2>/dev/null"):match("%S") ~= nil)
local running = false
if svc == "firewall" then
	local fw = exec_out("iptables -S 2>/dev/null")
	running = fw:find("zone_lan_input", 1, true) ~= nil or fw:find("zone_wan_input", 1, true) ~= nil
else
	local bin = ALLOWED_SVC[svc]
	if bin == "" then bin = svc end
	running = (exec_out("pidof " .. bin .. " 2>/dev/null"):match("%d+") ~= nil)
end

if #out > 2000 then out = out:sub(1, 2000) .. "\n...(truncated)" end

local action_ok = (code == 0)
if act == "enable" and not enabled then action_ok = false end
if act == "disable" and enabled then action_ok = false end

io.write(json.stringify({
	ok = action_ok,
	error = (not action_ok) and ("Command exited " .. tostring(code) .. (out ~= "" and (": " .. out) or "")) or nil,
	service = svc,
	action = act,
	running = running,
	enabled = enabled,
	exit_code = code,
	output = out
}) .. "\n")
LUA
