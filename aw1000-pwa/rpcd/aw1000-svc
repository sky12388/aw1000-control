				read -r input
				INPUT_JSON="$input" /usr/bin/lua - <<'LUA'
local json = require("luci.jsonc")
local req = json.parse(os.getenv("INPUT_JSON") or "{}") or {}
local pkg = tostring(req.package or ""):gsub("^%s+", ""):gsub("%s+$", "")

if not pkg:match("^[A-Za-z0-9._+-]+$") then
	io.write(json.stringify({ ok = false, error = "Invalid package name" }) .. "\n")
	os.exit(0)
end

local function get_overlay()
	local p = io.popen("df -k /overlay 2>/dev/null")
	local total_kb, used_kb, avail_kb = 0, 0, 0
	if p then
		p:read("*l")
		local line = p:read("*l") or ""
		p:close()
		local t, u, a = line:match("%S+%s+(%d+)%s+(%d+)%s+(%d+)")
		total_kb = tonumber(t) or 0
		used_kb = tonumber(u) or 0
		avail_kb = tonumber(a) or 0
	end
	return { total_kb = total_kb, used_kb = used_kb, avail_kb = avail_kb, avail_mb = math.floor(avail_kb / 1024 + 0.5) }
end

local ov = get_overlay()
if ov.avail_kb < 2048 then
	io.write(json.stringify({
		ok = false,
		package = pkg,
		error = "Insufficient /overlay free space (" .. tostring(ov.avail_kb) .. " KB available; need >= 2048 KB)",
		overlay = ov
	}) .. "\n")
	os.exit(0)
end

local p = io.popen("opkg install '" .. pkg .. "' 2>&1; echo __EXIT__$?")
local raw = p and p:read("*a") or ""
if p then p:close() end
local code = tonumber(raw:match("__EXIT__(%d+)")) or 1
local out = raw:gsub("__EXIT__%d+%s*$", "")
if #out > 6000 then out = out:sub(1, 6000) .. "\n...(truncated)" end

io.write(json.stringify({
	ok = (code == 0),
	package = pkg,
	exit_code = code,
	output = out,
	overlay = get_overlay()
}) .. "\n")
