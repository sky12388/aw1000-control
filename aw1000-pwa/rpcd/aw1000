#!/bin/sh
# ==============================================================================
# /usr/libexec/rpcd/aw1000 — Custom rpcd ubus plugin for AW1000 Control PWA
#
# HARD RULES:
#   1. NEVER modifies SSH (dropbear), NetBird (wt0), Tailscale, or
#      /etc/firewall.user raw/INPUT DROP rules.
#   2. Always creates a timestamped backup before editing MediaTek .dat files,
#      TTL config (/etc/config/3ginfo_ttl), or IMEI state.
#   3. Enforces Anti-Lockout Guard on Wi-Fi MAC blocklist changes.
# ==============================================================================

. /usr/share/libubox/jshn.sh

DAT_24="/etc/wireless/mediatek/mt7915.1.dat"
DAT_5G="/etc/wireless/mediatek/mt7915.2.dat"
WIFI_STATE="/tmp/wifi_watch_state/wifi"
MODEM_STATUS="/bin/modem_status"
CTL="/usr/bin/aw1000-ctl"
TM="/usr/bin/aw1000-telemetry"

read_dat_key() {
	local file="$1"
	local key="$2"
	[ -f "$file" ] || { echo ""; return; }
	awk -F'=' -v k="$key" '$1 == k { print $2; exit }' "$file" | tr -d '\r\n'
}

# Luhn 15-digit IMEI validator in POSIX sh/awk
validate_imei_luhn() {
	echo "$1" | awk '
	/^[0-9]{15}$/ {
		sum = 0
		for (i = 1; i <= 15; i++) {
			d = substr($0, i, 1) + 0
			if (i % 2 == 0) {
				d = d * 2
				if (d > 9) d = d - 9
			}
			sum += d
		}
		if (sum % 10 == 0) { print "1"; exit }
	}
	{ print "0" }'
}

# Resolve USB mount path (/mnt/usb or /mnt/sda1)
resolve_usb_mount() {
	for m in /mnt/usb /mnt/sda1; do
		if grep -q " $m " /proc/mounts 2>/dev/null; then
			echo "$m"
			return
		fi
	done
	if [ -d /mnt/usb ]; then echo "/mnt/usb"; else echo "/mnt/sda1"; fi
}

case "$1" in
	list)
		json_init
		json_add_object "status"
		json_close_object
		json_add_object "telemetry"
		json_close_object
		json_add_object "static_info"
		json_close_object
		json_add_object "modem_get"
		json_close_object
		json_add_object "wifi_get"
		json_close_object
		json_add_object "clients"
		json_close_object
		json_add_object "sms_list"
		json_close_object
		json_add_object "backup_list"
		json_close_object
		json_add_object "logs_get"
		json_close_object
		json_add_object "wifi_set"
			json_add_string "radio" "ra0|rai0"
			json_add_string "ssid" "string"
			json_add_string "password" "string"
			json_add_int "channel" 1
			json_add_int "ht_bw" 0
		json_close_object
		json_add_object "imei_set"
			json_add_string "imei" "15-digit-imei"
		json_close_object
		json_add_object "ttl_set"
			json_add_string "ttl" "off|1..255"
		json_close_object
		json_add_object "mac_acl"
			json_add_string "mac" "aa:bb:cc:dd:ee:ff"
			json_add_string "action" "block|unblock"
			json_add_string "client_ip" "caller-ip"
		json_close_object
		json_add_object "modem_restart"
		json_close_object
		json_add_object "backup_create"
			json_add_string "tag" "manual"
		json_close_object
		json_dump
		;;

	call)
		case "$2" in
			status)
				json_init
				nb_ip=$(ip -4 addr show dev wt0 2>/dev/null | awk '/inet / {print $2}' | head -n1)
				ts_ip=$(ip -4 addr show dev tailscale0 2>/dev/null | awk '/inet / {print $2}' | head -n1)
				wan_ip=$(ip -4 addr show dev ccmni2 2>/dev/null | awk '/inet / {print $2}' | head -n1)
				json_add_string "wt0_ip" "${nb_ip:-offline}"
				json_add_string "tailscale_ip" "${ts_ip:-offline}"
				json_add_string "ccmni2_ip" "${wan_ip:-offline}"
				json_dump
				;;

			telemetry)
				if [ -x "$TM" ]; then
					"$TM" --full | tr -d '\r\n' | sed 's/"clients":00/"clients":0/g'
					echo ""
				else
					echo '{"error":"aw1000-telemetry not found"}'
				fi
				;;

			static_info)
				if [ -x "$TM" ]; then
					"$TM" --static
				else
					echo '{"error":"aw1000-telemetry not found"}'
				fi
				;;

			modem_get)
				if [ -x "$CTL" ]; then
					"$CTL" modem-get
				else
					ttl_live=$(iptables -t mangle -S POSTROUTING 2>/dev/null | sed -n 's/.*--ttl-set \([0-9]*\).*/\1/p' | head -1)
					printf '{"ok":true,"ttl":{"enabled":%s,"val":%s,"live":%s}}\n' \
						"$([ -n "$ttl_live" ] && echo 1 || echo 0)" "${ttl_live:-64}" "${ttl_live:-null}"
				fi
				;;

			wifi_get)
				if [ -x "$CTL" ]; then
					"$CTL" wifi-get
				else
					json_init
					json_add_object "ra0"
						json_add_string "ssid" "$(read_dat_key "$DAT_24" "SSID1")"
						json_add_string "channel" "$(read_dat_key "$DAT_24" "Channel")"
						json_add_string "ht_bw" "$(read_dat_key "$DAT_24" "HT_BW")"
						json_add_string "acl_policy" "$(read_dat_key "$DAT_24" "AccessPolicy0")"
						json_add_string "acl_list" "$(read_dat_key "$DAT_24" "AccessControlList0")"
					json_close_object
					json_add_object "rai0"
						json_add_string "ssid" "$(read_dat_key "$DAT_5G" "SSID1")"
						json_add_string "channel" "$(read_dat_key "$DAT_5G" "Channel")"
						json_add_string "ht_bw" "$(read_dat_key "$DAT_5G" "HT_BW")"
						json_add_string "acl_policy" "$(read_dat_key "$DAT_5G" "AccessPolicy0")"
						json_add_string "acl_list" "$(read_dat_key "$DAT_5G" "AccessControlList0")"
					json_close_object
					json_dump
				fi
				;;

			clients)
				if [ -x "$TM" ]; then
					"$TM" --clients
				else
					json_init
					json_add_array "clients"
					json_close_array
					json_dump
				fi
				;;

			sms_list)
				if [ -x "$CTL" ]; then
					"$CTL" sms-list
				else
					echo '{"ok":true,"inbox":[],"outbox":[]}'
				fi
				;;

			backup_list)
				M="$(resolve_usb_mount)"
				mounted=false
				grep -q " $M " /proc/mounts 2>/dev/null && mounted=true
				set -- $(df -k "$M" 2>/dev/null | awk 'NR==2{print $2, $3, $4}')
				printf '{"ok":true,"mount":"%s","mounted":%s,"total_kb":%s,"used_kb":%s,"avail_kb":%s,"items":[' \
					"$M" "$mounted" "${1:-null}" "${2:-null}" "${3:-null}"
				f=1
				if [ "$mounted" = true ]; then
					for p in "$M"/backup-*.tar.gz "$M"/aw1000_backups/*.tar.gz "$M"/aw1000-backup-*/*.tar.gz; do
						[ -e "$p" ] || continue
						[ $f = 1 ] || printf ','; f=0
						sz="$(du -sk "$p" 2>/dev/null | awk '{print $1}')"
						mt="$(date -r "$p" '+%F %T' 2>/dev/null)"
						printf '{"path":"%s","name":"%s","size_kb":%s,"mtime":"%s"}' \
							"$p" "${p#$M/}" "${sz:-0}" "$mt"
					done
				fi
				printf ']}\n'
				;;

			logs_get)
				if [ -x "$CTL" ]; then
					"$CTL" logs all 1 80
				else
					json_init
					json_add_array "lines"
					logread | tail -n 60 | while IFS= read -r line; do
						json_add_string "" "$line"
					done
					json_close_array
					json_dump
				fi
				;;

			wifi_set)
				read -r input
				json_load "$input"
				json_get_var radio radio
				json_get_var ssid ssid
				json_get_var password password
				json_get_var channel channel
				json_get_var ht_bw ht_bw

				if [ "$radio" = "ra0" ]; then
					target="$DAT_24"
					case "$channel" in 1|6|11) ;; *)
						echo '{"ok":false,"error":"Invalid 2.4GHz channel (allowed: 1,6,11)"}'; exit 0 ;;
					esac
				elif [ "$radio" = "rai0" ]; then
					target="$DAT_5G"
					case "$channel" in 36|40|44|48|149|153|157|161) ;; *)
						echo '{"ok":false,"error":"Invalid 5GHz channel"}'; exit 0 ;;
					esac
				else
					echo '{"ok":false,"error":"Invalid radio (must be ra0 or rai0)"}'; exit 0
				fi

				case "$ht_bw" in 0|1) ;; *)
					echo '{"ok":false,"error":"Invalid HT_BW (must be 0 or 1)"}'; exit 0 ;;
				esac

				clean_ssid=$(printf '%s' "$ssid" | tr -d '\r\n')
				ssid_len=${#clean_ssid}
				if [ "$ssid_len" -lt 1 ] || [ "$ssid_len" -gt 32 ]; then
					echo '{"ok":false,"error":"SSID must be 1-32 characters"}'; exit 0
				fi

				clean_pass=""
				pass_updated=0
				if [ -n "$password" ]; then
					clean_pass=$(printf '%s' "$password" | tr -d '\r\n')
					pass_len=${#clean_pass}
					if [ "$pass_len" -lt 8 ] || [ "$pass_len" -gt 63 ]; then
						echo '{"ok":false,"error":"WPA passphrase must be 8-63 characters"}'; exit 0
					fi
					pass_updated=1
				fi

				ts=$(date +%Y%m%d-%H%M%S)
				bak="${target}.${ts}.pwa-bak"
				cp -p "$target" "$bak" || {
					echo '{"ok":false,"error":"Backup failed; aborting write"}'; exit 0
				}

				tmp_dat="${target}.pwa-tmp"
				AW_SSID="$clean_ssid" AW_PASS="$clean_pass" awk -v c="$channel" -v b="$ht_bw" -v up="$pass_updated" '
				BEGIN { s=ENVIRON["AW_SSID"]; p=ENVIRON["AW_PASS"]; seen_s=0; seen_c=0; seen_b=0; seen_p=0 }
				/^SSID1=/ { print "SSID1=" s; seen_s=1; next }
				/^Channel=/ { print "Channel=" c; seen_c=1; next }
				/^HT_BW=/ { print "HT_BW=" b; seen_b=1; next }
				/^WPAPSK1=/ {
					if (up == 1) { print "WPAPSK1=" p } else { print $0 }
					seen_p=1; next
				}
				{ print $0 }
				END {
					if (!seen_s) print "SSID1=" s
					if (!seen_c) print "Channel=" c
					if (!seen_b) print "HT_BW=" b
					if (up == 1 && !seen_p) print "WPAPSK1=" p
				}' "$target" > "$tmp_dat" && mv "$tmp_dat" "$target" && chmod 644 "$target" || {
					rm -f "$tmp_dat"
					echo '{"ok":false,"error":"Failed to write MediaTek .dat file"}'; exit 0
				}

				( sleep 1 && wifi restart >/dev/null 2>&1 ) &

				json_init
				json_add_boolean "ok" 1
				json_add_string "backup" "$bak"
				json_add_string "radio" "$radio"
				json_add_string "ssid" "$clean_ssid"
				json_add_boolean "password_updated" "$pass_updated"
				json_dump
				;;

			imei_set)
				read -r input
				json_load "$input"
				json_get_var imei imei

				if [ "$(validate_imei_luhn "$imei")" != "1" ]; then
					echo '{"ok":false,"error":"IMEI failed 15-digit Luhn checksum validation"}'
					exit 0
				fi

				# Backup current static telemetry / old IMEI before changing
				mkdir -p /root/aw1000-imei-backups
				old_imei=$($MODEM_STATUS --run_atcmd 'AT+EGMR=0,7' 2>/dev/null | grep -oE '[0-9]{15}' | head -1)
				echo "$(date -Iseconds) old_imei=${old_imei:-unknown} new_imei=${imei}" >> /root/aw1000-imei-backups/imei-history.log

				$MODEM_STATUS --at_cmd "AT+EGMR=1,7,\"${imei}\"" >/dev/null 2>&1 || \
					$MODEM_STATUS --run_atcmd "AT+EGMR=1,7,\"${imei}\"" >/dev/null 2>&1
				rm -f /tmp/aw1000-tm/static.json

				# Restart modem radio (CFUN=4 -> CFUN=1) without rebooting router
				(
					$MODEM_STATUS --at_cmd 'AT+CFUN=4' >/dev/null 2>&1
					sleep 2
					$MODEM_STATUS --at_cmd 'AT+CFUN=1' >/dev/null 2>&1
				) &

				json_init
				json_add_boolean "ok" 1
				json_add_string "imei" "$imei"
				json_add_string "previous_imei" "${old_imei:-unknown}"
				json_dump
				;;

			ttl_set)
				read -r input
				json_load "$input"
				json_get_var ttl ttl

				# Backup existing TTL configuration first
				ts=$(date +%Y%m%d-%H%M%S)
				[ -f /etc/config/3ginfo_ttl ] && cp -p /etc/config/3ginfo_ttl "/etc/config/3ginfo_ttl.${ts}.pwa-bak"
				[ -f /etc/firewall.d/3ginfo_ttl ] && cp -p /etc/firewall.d/3ginfo_ttl "/etc/firewall.d/3ginfo_ttl.${ts}.pwa-bak"

				if [ -x "$CTL" ]; then
					"$CTL" ttl-set "$ttl"
				else
					echo '{"ok":false,"error":"aw1000-ctl not found"}'
				fi
				;;

			mac_acl)
				read -r input
				json_load "$input"
				json_get_var mac mac
				json_get_var action action
				json_get_var client_ip client_ip

				norm_mac=$(printf '%s' "$mac" | tr 'a-f' 'A-F' | grep -oE '^[0-9A-F]{2}(:[0-9A-F]{2}){5}$')
				if [ -z "$norm_mac" ]; then
					echo '{"ok":false,"error":"Invalid MAC address format"}'
					exit 0
				fi

				# Anti-Lockout Guard: check caller IP in ARP/neighbor table
				if [ -n "$client_ip" ]; then
					caller_mac=$(ip neigh show "$client_ip" 2>/dev/null | awk '{print toupper($5); exit}')
					if [ -n "$caller_mac" ] && [ "$caller_mac" = "$norm_mac" ] && [ "$action" = "block" ]; then
						echo '{"ok":false,"error":"Anti-Lockout Guard: refusing to block current admin device MAC"}'
						exit 0
					fi
				fi

				ts=$(date +%Y%m%d-%H%M%S)
				for f in "$DAT_24" "$DAT_5G"; do
					[ -f "$f" ] || continue
					cp -p "$f" "${f}.${ts}.acl-bak" || {
						echo '{"ok":false,"error":"Failed to back up .dat file before ACL update"}'
						exit 0
					}
					cur=$(read_dat_key "$f" "AccessControlList0" | tr 'a-f' 'A-F')
					new_list=$(echo "$cur" | tr ';' '\n' | grep -E '^[0-9A-F]{2}(:[0-9A-F]{2}){5}$' | grep -Fxv "$norm_mac" | paste -sd ';' -)
					if [ "$action" = "block" ]; then
						if [ -n "$new_list" ]; then
							new_list="${new_list};${norm_mac}"
						else
							new_list="${norm_mac}"
						fi
					fi
					sed -i \
						-e "s/^AccessPolicy0=.*/AccessPolicy0=2/" \
						-e "s/^AccessControlList0=.*/AccessControlList0=${new_list}/" \
						"$f"
				done

				( sleep 1 && wifi reload >/dev/null 2>&1 || wifi restart >/dev/null 2>&1 ) &

				json_init
				json_add_boolean "ok" 1
				json_add_string "mac" "$norm_mac"
				json_add_string "action" "$action"
				json_dump
				;;

			modem_restart)
				if [ -x "$CTL" ]; then
					"$CTL" modem-restart
				else
					(
						$MODEM_STATUS --at_cmd 'AT+CFUN=4' >/dev/null 2>&1
						sleep 2
						$MODEM_STATUS --at_cmd 'AT+CFUN=1' >/dev/null 2>&1
					) &
					echo '{"ok":true}'
				fi
				;;

			backup_create)
				read -r input
				json_load "$input" 2>/dev/null
				json_get_var tag tag
				tag=$(printf '%s' "${tag:-pwa}" | tr -cd 'A-Za-z0-9_-')
				M="$(resolve_usb_mount)"
				if ! grep -q " $M " /proc/mounts 2>/dev/null; then
					echo '{"ok":false,"error":"USB storage is not mounted on /mnt/usb or /mnt/sda1"}'
					exit 0
				fi
				mkdir -p "$M/aw1000_backups"
				ts="$(date '+%Y%m%d-%H%M%S')"
				out="$M/aw1000_backups/backup-aw1000-${ts}-${tag}.tar.gz"
				sysupgrade -b "$out" >/dev/null 2>&1 || \
					tar -czf "$out" /etc/config /etc/firewall.user /etc/wireless/mediatek/*.dat 2>/dev/null || {
						echo '{"ok":false,"error":"Backup archive creation failed"}'
						exit 0
					}
				sha="$(sha256sum "$out" | awk '{print $1}')"
				echo "$sha  $(basename "$out")" > "${out}.sha256"
				sz="$(du -sk "$out" | awk '{print $1}')"
				printf '{"ok":true,"path":"%s","name":"%s","size_kb":%s,"sha256":"%s"}\n' \
					"$out" "${out#$M/}" "${sz:-0}" "$sha"
				;;
		esac
		;;
esac
